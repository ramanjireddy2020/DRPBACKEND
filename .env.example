# ── Auth ───────────────────────────────────────────────────────────────────────
SECRET_KEY=your-secret-key-here

# ── AWS Cognito (the frontend's identity provider) ─────────────────────────────
# Set COGNITO_USER_POOL_ID to have /v1 accept Cognito-issued RS256 tokens.
# Leave it empty to keep /v1 on its own HS256 tokens from /v1/auth/login.
# Both values are public identifiers, not secrets.
COGNITO_REGION=us-east-1
COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_ID=
COGNITO_AUTO_PROVISION=true

# Browser origins allowed to call the API, e.g. ["http://localhost:3001"].
# Empty means the credential-less wildcard (bearer-token clients only).
CORS_ORIGINS=[]

# ── Database ───────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./innodd.db
NOVELTY_DATABASE_URL=sqlite:///./noveltysearch.db

# ── Groq LLM ───────────────────────────────────────────────────────────────────
GROQ_API_KEY=your-groq-api-key

# ── Google Gemini ──────────────────────────────────────────────────────────────
GOOGLE_API_KEY=your-google-api-key

# ── SerpAPI ────────────────────────────────────────────────────────────────────
SERPAPI_API_KEY=your-serpapi-key

# ── Langfuse observability ─────────────────────────────────────────────────────
LANGFUSE_SECRET_KEY=your-langfuse-secret-key
LANGFUSE_PUBLIC_KEY=your-langfuse-public-key
LANGFUSE_HOST=https://us.cloud.langfuse.com

# ── Azure OpenAI (optional) ────────────────────────────────────────────────────
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your-azure-openai-key
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-05-01-preview

# -- ScreenSuite (module 4 - docking) ----------------------------------------
# Two external executables, neither pip-installable. Empty searches PATH.
# Docking cannot run without both; GET /api/v1/screening/health says which are
# missing. There is no supported AutoDock Vina build for Windows.
SCREENING_VINA_PATH=
SCREENING_OBABEL_PATH=
# Where run output goes. Empty keeps the in-repo app/data layout. On Databricks
# point this at a UC volume - local cluster storage is ephemeral.
SCREENING_OUTPUT_ROOT=
# "site" boxes the co-crystal ligand (default); "protein" is blind docking over
# the whole structure, which makes affinities non-comparable between receptors.
SCREENING_BOX_MODE=site
SCREENING_BOX_PADDING=8.0
SCREENING_BOX_MIN_SIZE=20.0
SCREENING_BOX_MAX_SIZE=40.0
SCREENING_NUM_MODES=9
SCREENING_EXHAUSTIVENESS=8
SCREENING_TOP_FRACTION=0.05
# Cost guard: a batch over this many protein x drug pairs is refused up front.
SCREENING_MAX_COMBINATIONS=200
SCREENING_SUBPROCESS_TIMEOUT=360
SCREENING_RESOLVE_TIMEOUT=20
SCREENING_RESOLVE_MAX_MATCHES=5
