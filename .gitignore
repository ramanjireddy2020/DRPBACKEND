.databricks/
build/
dist/
__pycache__/
*.egg-info
.venv/
scratch/**
!scratch/README.md
**/explorations/**
**/!explorations/README.md

# Python
**/*.pyc
**/*.pyo
**/*.pyd

# Runtime data (generated at runtime, not committed)
data/
logs/
*.log
nohup.out

# Databases (created at runtime)
*.db

# Secrets — never commit
.env
src/DRP_Main/app/api/v1/endpoints/.env

# OS / IDE
.DS_Store
.idea/
.vscode/
*.swp

# Claude Code local state (CLAUDE.md is tracked as project documentation)
.claude/

# AWS Lambda proxy build output — vendored dependencies and packaged zips.
# Regenerated by the packaging script; ~180 files that also break `databricks
# sync` (it cannot create their deeply nested dist-info directories).
integrations/aws_proxy/lambda_package/
integrations/aws_proxy/layer_build/
integrations/aws_proxy/*.zip
integrations.zip

# ScreenSuite external binaries (AutoDock Vina, optionally Open Babel).
# Downloaded per platform from the upstream releases page, never vendored:
# https://github.com/ccsb-scripps/AutoDock-Vina/releases
# docking_service searches bin/ automatically; SCREENING_VINA_PATH overrides.
bin/

# Large BioKG data files — too large for git (use DVC or direct download)
src/DRP_Main/app/api/v1/endpoints/biokg_data/*.tsv
src/DRP_Main/app/api/v1/endpoints/biokg_data/*.pkl
src/DRP_Main/app/api/v1/endpoints/biokg_data/biokg-master/chemical_drugbank.txt.gz

# Contains a live service-principal OAuth secret - keep local
innodd-api.postman_collection.json
src/DRP_Main/app/api/v1/endpoints/biokg_data.zip
